<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div style="line-height:30%;">
      <br>
    </div>
    {% if include.limit and site.announcements.scrollable %}<div class="news-scroll-frame">{% endif %}
    <div
      class="table-responsive{% if include.limit and site.announcements.scrollable %} news-scroll{% endif %}"
      {% if include.limit and site.announcements.scrollable %}
        tabindex="0"
        role="region"
        aria-label="News, scroll for older entries"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | sort: 'date' | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 12%;">{{ item.date | date: '%b, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit and site.announcements.scrollable %}
      <span class="news-scrollbar" aria-hidden="true"><span class="news-scrollbar-thumb"></span></span>
      </div>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
